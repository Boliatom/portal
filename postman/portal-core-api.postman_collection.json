{
  "info": {
    "name": "Portal Core API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Логин",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"test\", \"password\": \"test1234\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/login/"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] }
        }
      ]
    },
    {
      "name": "Информация о пользователе",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/2/" }
    },
    {
      "name": "Группы пользователя",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/2/groups/" }
    },
    {
      "name": "Пользователи группы",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/groups/1/users/" }
    },
    {
      "name": "Авторизован ли пользователь",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/check/" }
    },
    {
      "name": "Список модулей",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/modules/" }
    },
    {
      "name": "Без токена",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/api/users/2/"
      }
    }
  ]
}
